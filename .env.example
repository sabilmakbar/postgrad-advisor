# Copy to .env and fill in. A provider with no key is skipped in the fallback chain.
GOOGLE_API_KEY=
GROQ_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
TAVILY_API_KEY=

# Content-free local operational traces (disabled by default).
# TRACE_ENABLED=true
# TRACE_PATH=data/traces.jsonl

# Optional overrides (defaults live in app/config.py)
# GEMINI_MODEL=
# GROQ_MODEL=
# WORKERS_AI_MODEL=
# GEMINI_RPM=
# GROQ_RPM=

# Light tier (FR-011): blank an id to disable that provider for light;
# all light ids blank = light tier off (calls degrade to heavy).
# GEMINI_LIGHT_MODEL=
# GROQ_LIGHT_MODEL=
# WORKERS_AI_LIGHT_MODEL=
# GEMINI_LIGHT_RPM=
# GROQ_LIGHT_RPM=
